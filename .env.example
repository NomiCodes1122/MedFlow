# ==============================================================================
# MedFlow Server Environment Configuration (.env.example)
# ==============================================================================
# Security Notice:
# 1. NEVER commit real production or development database credentials to version control.
# 2. Database credentials and secrets are strictly accessible by the Express backend API only.
# 3. Mobile (React Native) and Web (React) clients MUST NEVER receive these connection strings.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:19006"
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONNECTION STRINGS
# ------------------------------------------------------------------------------
# Runtime Application Database Connection (Supabase Transaction Pooler)
# Used by Express API during runtime queries. Uses connection pooling (PgBouncer/Supavisor).
# Note: When using Supabase transaction pooling on port 6543, append "?pgbouncer=true".
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI & Migration Database Connection (Supabase Direct Session Connection)
# Used exclusively by Prisma CLI for migrations, introspections, and direct session commands.
# Does NOT route through transaction pooling. Port 5432 direct connection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# REDIS CLOUD CONFIGURATION
# ------------------------------------------------------------------------------
# Used for Socket.IO Redis adapter, ephemeral GPS telemetry cache, and rate limiting.
REDIS_URL="redis://default:[PASSWORD]@[REDIS-HOST]:[PORT]"

# ------------------------------------------------------------------------------
# FIREBASE ADMIN SDK CONFIGURATION
# ------------------------------------------------------------------------------
# Used by Express server to verify Firebase Phone Auth tokens and dispatch push alerts.
FIREBASE_PROJECT_ID="medflow-prototype"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-[ID]@medflow-prototype.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n[YOUR-ESCAPED-PRIVATE-KEY]\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS (FOR FUTURE PHASES)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="CHANGE_ME_IN_LOCAL_ENV_MIN_32_CHARS_LONG"
JWT_REFRESH_SECRET="CHANGE_ME_IN_LOCAL_ENV_MIN_32_CHARS_LONG"
